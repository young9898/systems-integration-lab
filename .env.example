# Copy this file to .env before the first `docker compose up`.
#
#     cp .env.example .env
#
# .env is gitignored. Never commit it, and never put a real password in this
# example file — it IS committed.
#
# This password is used twice: Postgres creates its user with it, and the
# middleware authenticates with it. They read the same variable so they cannot
# drift apart.
#
# It only guards a database that is not reachable outside the compose network,
# so any value works for local lab use. Generate one rather than typing a word:
#
#     openssl rand -base64 24
#
DB_PASSWORD=change_me_before_first_run
